#!/usr/bin/env bash
# clipbasket-capture — the payload `wl-paste --watch` runs on every clipboard
# change. It classifies the offer, turns it into a clip JSON document, and
# hands that to clipbasket-db.
#
#   wl-paste --type text  --watch clipbasket-capture text
#   wl-paste --type image --watch clipbasket-capture image
#
# The clipboard content arrives on stdin; the *offer* (which MIME types the
# source advertises) is read back with `wl-paste --list-types`, because that is
# the only way to see the markers a password manager attaches and the only way
# to tell a file copy from the plain-text rendering of the same paths.
#
# Two watchers, not three: which one records a given change is decided here
# from the offer, so a copy that carries both an image and its alt text is
# recorded once. Priority matches the Tauri app — files, then image, then text.
#
# A web copy also advertises text/html. That is a *flavour*, not a kind: the
# plain text stays the clip's text so an ordinary paste is unchanged, and the
# markup rides along in `html` for `clipbasket-db markdown` to convert later.

set -euo pipefail

STATE_DIR="${CLIPBASKET_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/clipbasket}"
IMAGE_DIR="$STATE_DIR/images"
THUMB_DIR="$STATE_DIR/thumbs"
SUPPRESS_FILE="$STATE_DIR/suppress"

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
DB_CLI="${CLIPBASKET_DB_CLI:-$SCRIPT_DIR/clipbasket-db}"

MAX_TEXT_BYTES="${CLIPBASKET_MAX_TEXT_BYTES:-8388608}"    # 8 MiB, as in the Tauri app
MAX_HTML_BYTES="${CLIPBASKET_MAX_HTML_BYTES:-8388608}"    # CLIPBOARD_HTML_MAX_BYTES
MAX_IMAGE_BYTES="${CLIPBASKET_MAX_IMAGE_BYTES:-67108864}" # 64 MiB
MAX_FILE_ITEMS="${CLIPBASKET_MAX_FILE_ITEMS:-1024}"
MAX_CLIPS="${CLIPBASKET_MAX_CLIPS:-1000}"
THUMB_SIZE="${CLIPBASKET_THUMB_SIZE:-224}"

TMPFILES=()
cleanup() {
	if [ "${#TMPFILES[@]}" -gt 0 ]; then
		rm -f "${TMPFILES[@]}"
	fi
}
trap cleanup EXIT

log() { printf 'clipbasket-capture: %s\n' "$*" >&2; }

mktempfile() {
	local path
	path=$(mktemp "${TMPDIR:-/tmp}/clipbasket-capture.XXXXXX")
	TMPFILES+=("$path")
	printf '%s' "$path"
}

# --- JSON encoding ---------------------------------------------------------

# Escapes stdin into the *body* of a JSON string (no surrounding quotes).
# Streams, so an 8 MiB clip never has to live in a shell variable, and encodes
# every control character rather than dropping it.
json_escape_stream() {
	awk '
		BEGIN { ORS = "" }
		{
			if (NR > 1) printf "\\n"
			s = $0
			gsub(/\\/, "\\\\", s)
			gsub(/"/,  "\\\"", s)
			gsub(/\t/, "\\t",  s)
			gsub(/\r/, "\\r",  s)
			gsub(/\010/, "\\b", s)
			gsub(/\014/, "\\f", s)
			gsub(/[\001-\037]/, " ", s)
			printf "%s", s
		}'
}

json_string() {
	printf '"%s"' "$(printf '%s' "${1-}" | json_escape_stream)"
}

# Emits `"key":value` or `"key":null`, so an absent field is never the empty
# string masquerading as a value.
json_field() {
	if [ -z "${2-}" ]; then
		printf '%s:null' "$(json_string "$1")"
	else
		printf '%s:%s' "$(json_string "$1")" "$(json_string "$2")"
	fi
}

json_number_field() {
	if [ -z "${2-}" ]; then
		printf '%s:null' "$(json_string "$1")"
	else
		printf '%s:%s' "$(json_string "$1")" "$2"
	fi
}

# --- helpers ---------------------------------------------------------------

sha256_of() {
	# $1 kind prefix, $2 file. The kind is folded in so the same bytes offered
	# as two different kinds cannot collide, matching the Tauri dedupe keys.
	{
		printf '%s\n' "$1"
		cat -- "$2"
	} | {
		if command -v sha256sum >/dev/null 2>&1; then
			sha256sum
		else
			shasum -a 256
		fi
	} | cut -d' ' -f1
}

file_size() {
	wc -c <"$1" | tr -d ' '
}

# --- guards ----------------------------------------------------------------

# wl-clipboard >= 2.2 sets CLIPBOARD_STATE for the watched command: data, nil,
# clear, or sensitive. "sensitive" is the Wayland convention for a payload a
# clipboard manager must not record; the other two non-data states carry
# nothing worth recording either.
clipboard_state_is_recordable() {
	case "${CLIPBOARD_STATE-}" in
	'' | data) return 0 ;;
	*)
		log "skipping clipboard change (CLIPBOARD_STATE=$CLIPBOARD_STATE)"
		return 1
		;;
	esac
}

# The other half of the same convention: password managers advertise an extra
# MIME type on the offer rather than setting an env var. x-kde-passwordManagerHint
# is what KeePassXC, KDE and the GTK password managers use; the nspasteboard.org
# markers show up on offers bridged from macOS.
offer_is_confidential() {
	case "$1" in
	*x-kde-passwordManagerHint* | *x-kde-passwordManagerHint*) return 0 ;;
	esac
	case "$1" in
	*ConcealedType* | *TransientType* | *AutoGeneratedType*) return 0 ;;
	esac
	# Some toolkits spell it lowercase.
	case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
	*passwordmanagerhint* | *"x-kde-password"*) return 0 ;;
	esac
	return 1
}

# One-shot self-capture suppression. `clipbasket-db copy` writes the hash of
# whatever it just put on the clipboard; the echo that comes straight back is
# swallowed here. The token is cleared whether or not it matched, so a stale
# one can never hide a later, genuine clipboard change.
consume_suppression() {
	local want token=''
	want="$1"
	[ -f "$SUPPRESS_FILE" ] || return 1
	read -r token <"$SUPPRESS_FILE" || token=''
	rm -f "$SUPPRESS_FILE"
	[ "$token" = "$want" ]
}

# --- source app ------------------------------------------------------------

# Best effort, and deliberately cheap: whatever window has focus at the moment
# of the copy. Same approximation the Tauri app makes on macOS and Windows.
source_app() {
	command -v hyprctl >/dev/null 2>&1 || return 0
	hyprctl activewindow 2>/dev/null |
		awk -F': ' '/^[[:space:]]*initialClass: /{ print $2; exit }' |
		tr -d '\r'
}

# --- URL handling ----------------------------------------------------------

# Mirrors detected_url(): a URL clip is a payload that is *entirely* one URL.
# Anything with whitespace is prose that happens to contain a link, and
# file:// is a file reference rather than a link.
is_url() {
	case "$1" in
	*[[:space:]]* | '') return 1 ;;
	file://*) return 1 ;;
	esac
	case "$1" in
	[a-zA-Z]*://?*) return 0 ;;
	esac
	return 1
}

url_domain() {
	local rest=${1#*://}
	rest=${rest%%/*}
	rest=${rest%%\?*}
	rest=${rest%%#*}
	rest=${rest##*@}
	# Leaves an IPv6 literal's brackets alone; strips a trailing :port.
	case "$rest" in
	'['*) rest=${rest%%]*}] ;;
	*) rest=${rest%%:*} ;;
	esac
	rest=$(printf '%s' "$rest" | tr 'A-Z' 'a-z')
	printf '%s' "${rest#www.}"
}

# domain + path + query, the way the Tauri app renders a link row.
url_preview() {
	local url="$1" domain="$2" rest path query
	rest=${url#*://}
	rest=${rest%%#*}
	case "$rest" in
	*\?*)
		query=${rest#*\?}
		rest=${rest%%\?*}
		;;
	*) query='' ;;
	esac
	case "$rest" in
	*/*) path=/${rest#*/} ;;
	*) path='' ;;
	esac
	while [ "${path: -1}" = "/" ]; do path=${path%/}; done
	printf '%s%s' "$domain" "$path"
	[ -n "$query" ] && printf '?%s' "$query"
	return 0
}

# --- file lists ------------------------------------------------------------

url_decode() {
	local s=${1//\\/\\\\}
	printf '%b' "${s//%/\\x}"
}

# Reads a text/uri-list on stdin and prints one decoded local path per line.
# Non-file schemes and the comment lines the spec allows are dropped.
uri_list_paths() {
	local line path
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line%$'\r'}
		case "$line" in
		'#'* | '') continue ;;
		file://*) ;;
		*) continue ;;
		esac
		path=${line#file://}
		path=${path#*/}     # drop an (empty or otherwise) authority
		path=$(url_decode "/$path")
		[ -n "$path" ] && printf '%s\n' "$path"
	done
}

files_json_from() {
	# $1 file containing one path per line
	local path name extension first=1
	printf '['
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		name=${path##*/}
		case "$name" in
		?*.*) extension=$(printf '%s' "${name##*.}" | tr 'A-Z' 'a-z') ;;
		*) extension='' ;;
		esac
		[ "$first" = 1 ] || printf ','
		first=0
		printf '{'
		json_field path "$path"
		printf ','
		json_field name "$name"
		printf ','
		json_field extension "$extension"
		printf ',"is_directory":'
		if [ -d "$path" ]; then printf 'true'; else printf 'false'; fi
		printf '}'
	done <"$1"
	printf ']'
}

file_list_preview() {
	# $1 file containing one path per line, $2 count
	local count="$2" first second
	first=$(head -1 "$1")
	first=${first##*/}
	case "$count" in
	0) printf 'Files' ;;
	1) printf '%s' "$first" ;;
	2)
		second=$(sed -n '2p' "$1")
		printf '%s, %s' "$first" "${second##*/}"
		;;
	*)
		second=$(sed -n '2p' "$1")
		printf '%s, %s, +%s' "$first" "${second##*/}" "$((count - 2))"
		;;
	esac
}

# --- images ----------------------------------------------------------------

extension_for_mime() {
	case "$1" in
	image/png) printf 'png' ;;
	image/jpeg | image/jpg) printf 'jpg' ;;
	image/gif) printf 'gif' ;;
	image/webp) printf 'webp' ;;
	image/bmp | image/x-bmp | image/x-ms-bmp) printf 'bmp' ;;
	image/tiff) printf 'tiff' ;;
	image/svg+xml) printf 'svg' ;;
	image/avif) printf 'avif' ;;
	*) printf 'bin' ;;
	esac
}

first_image_mime() {
	printf '%s\n' "$1" | awk '/^image\//{ print; exit }'
}

magick_cmd() {
	if command -v magick >/dev/null 2>&1; then
		printf 'magick'
	elif command -v convert >/dev/null 2>&1; then
		printf 'convert'
	fi
}

# Prints "WIDTH HEIGHT", or nothing. ImageMagick when it is installed;
# otherwise the PNG header, which covers what compositors and screenshot tools
# actually put on a Wayland clipboard.
image_dimensions() {
	local file="$1" magick
	magick=$(magick_cmd)
	if [ -n "$magick" ]; then
		"$magick" identify -format '%w %h' "${file}[0]" 2>/dev/null && return 0
	fi
	# 89 50 4E 47 = \x89PNG; IHDR width/height are bytes 16..23, big-endian.
	if [ "$(od -An -tx1 -N4 "$file" | tr -d ' \n')" = "89504e47" ]; then
		od -An -tu1 -j16 -N8 "$file" |
			awk '{ printf "%d %d", $1*16777216+$2*65536+$3*256+$4, $5*16777216+$6*65536+$7*256+$8 }'
	fi
}

# Prints the thumbnail path, or the original when no resizer is available —
# QML scales what it is given, so a missing ImageMagick degrades the memory
# footprint of the grid, not its correctness.
make_thumbnail() {
	local source="$1" hash="$2" magick thumb
	thumb="$THUMB_DIR/$hash.png"
	if [ -f "$thumb" ]; then
		printf '%s' "$thumb"
		return 0
	fi
	magick=$(magick_cmd)
	if [ -z "$magick" ]; then
		printf '%s' "$source"
		return 0
	fi
	if "$magick" "${source}[0]" -thumbnail "${THUMB_SIZE}x${THUMB_SIZE}>" \
		-background none -alpha background "$thumb" 2>/dev/null && [ -s "$thumb" ]; then
		printf '%s' "$thumb"
	else
		rm -f "$thumb"
		printf '%s' "$source"
	fi
}

# --- the text/html flavour -------------------------------------------------

# CRLF out, invalid UTF-8 out -- the same two guarantees capture_text makes
# about the plain text, because everything downstream (JSON, SQLite, QML)
# assumes valid UTF-8. Reads $1, writes $2.
normalise_utf8() {
	if command -v iconv >/dev/null 2>&1; then
		tr -d '\r' <"$1" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null >"$2"
	else
		tr -d '\r' <"$1" >"$2"
	fi
}

# Prints the path of a temp file holding the offer's text/html rendering, or
# nothing. HTML is an *extra flavour* on a text clip, never a kind of its own:
# the plain text stays the clip's `text`, so a normal paste keeps producing the
# plain text and only "Copy as Markdown" reaches for this. Same split as
# captured_text_like_clip() on macOS, where html_content rides alongside
# text_content on a Text or Url clip.
read_html_flavor() {
	local types="$1" mime file clean size
	mime=$(printf '%s\n' "$types" | awk '/^text\/html([;[:space:]]|$)/ { print; exit }')
	[ -n "$mime" ] || return 0

	file=$(mktempfile)
	wl-paste --no-newline --type "$mime" >"$file" 2>/dev/null || return 0
	size=$(file_size "$file")
	[ "$size" -gt 0 ] || return 0
	if [ "$size" -gt "$MAX_HTML_BYTES" ]; then
		log "dropping ${size}-byte html flavour (limit $MAX_HTML_BYTES); keeping the plain text"
		return 0
	fi

	clean=$(mktempfile)
	normalise_utf8 "$file" "$clean"
	[ -s "$clean" ] || return 0
	printf '%s' "$clean"
}

# --- recording -------------------------------------------------------------

record() {
	# JSON payload on stdin
	local out
	if ! out=$("$DB_CLI" insert); then
		log "insert failed: $out"
		return 1
	fi
	case "$out" in
	*'"deduped":true'*) return 0 ;;
	esac
	"$DB_CLI" prune --max "$MAX_CLIPS" >/dev/null 2>&1 || true
}

capture_files() {
	local paths count hash payload preview app mime='' first
	paths=$(mktempfile)
	wl-paste --no-newline --type text/uri-list 2>/dev/null | uri_list_paths >"$paths" || true
	count=$(wc -l <"$paths" | tr -d ' ')
	[ "$count" -gt 0 ] || return 1
	if [ "$count" -gt "$MAX_FILE_ITEMS" ]; then
		log "skipping file list of $count items (limit $MAX_FILE_ITEMS)"
		return 0
	fi

	hash=$(sha256_of files "$paths")
	if consume_suppression "$hash"; then
		return 0
	fi

	first=$(head -1 "$paths")
	if command -v file >/dev/null 2>&1 && [ -e "$first" ]; then
		mime=$(file -b --mime-type -- "$first" 2>/dev/null || printf '')
	fi
	preview=$(file_list_preview "$paths" "$count")
	app=$(source_app)

	payload=$(mktempfile)
	{
		printf '{"kind":"files",'
		json_field hash "$hash"
		printf ','
		json_field preview "$preview"
		printf ','
		json_field source_app "$app"
		printf ','
		json_field mime "$mime"
		printf ',"file_count":%s,"files":' "$count"
		files_json_from "$paths"
		printf '}'
	} >"$payload"
	record <"$payload"
}

capture_image() {
	local stdin_file="$1" types="$2" mime extension hash target thumb dims width='' height='' size app payload preview

	size=$(file_size "$stdin_file")
	[ "$size" -gt 0 ] || return 1
	if [ "$size" -gt "$MAX_IMAGE_BYTES" ]; then
		log "skipping ${size}-byte image (limit $MAX_IMAGE_BYTES)"
		return 0
	fi

	mime=$(first_image_mime "$types")
	[ -n "$mime" ] || mime=image/png
	extension=$(extension_for_mime "$mime")

	# Content-addressed: the same screenshot copied twice is one file on disk
	# and one dedupe key, without ever decoding the pixels.
	hash=$(sha256_of image "$stdin_file")
	if consume_suppression "$hash"; then
		return 0
	fi

	mkdir -p "$IMAGE_DIR" "$THUMB_DIR"
	target="$IMAGE_DIR/$hash.$extension"
	[ -f "$target" ] || cp -- "$stdin_file" "$target"

	dims=$(image_dimensions "$target" || printf '')
	if [ -n "$dims" ]; then
		width=${dims%% *}
		height=${dims##* }
	fi
	thumb=$(make_thumbnail "$target" "$hash")

	if [ -n "$width" ] && [ -n "$height" ]; then
		preview="Image ${width}x${height}"
	else
		preview="Image"
	fi
	app=$(source_app)

	payload=$(mktempfile)
	{
		printf '{"kind":"image",'
		json_field hash "$hash"
		printf ','
		json_field preview "$preview"
		printf ','
		json_field source_app "$app"
		printf ','
		json_field image_path "$target"
		printf ','
		json_field thumb_path "$thumb"
		printf ','
		json_field mime "$mime"
		printf ','
		json_number_field image_width "$width"
		printf ','
		json_number_field image_height "$height"
		printf ','
		json_number_field size_bytes "$size"
		printf '}'
	} >"$payload"
	record <"$payload"
}

capture_text() {
	local stdin_file="$1" types="${2-}"
	local size text_file html_file='' hash app payload kind=text domain='' preview='' head_line

	size=$(file_size "$stdin_file")
	[ "$size" -gt 0 ] || return 1
	if [ "$size" -gt "$MAX_TEXT_BYTES" ]; then
		log "skipping ${size}-byte text clip (limit $MAX_TEXT_BYTES)"
		return 0
	fi

	# Normalise the way the Tauri app does — CRLF to LF, then trim — and make
	# sure what lands in the database is valid UTF-8, because everything
	# downstream (JSON, FTS, QML) assumes it is.
	text_file=$(mktempfile)
	if command -v iconv >/dev/null 2>&1; then
		tr -d '\r' <"$stdin_file" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null |
			awk 'BEGIN { blank = "" }
			     { if (seen) printf "%s", blank; if ($0 ~ /^[[:space:]]*$/ && !seen) next;
			       printf "%s", $0; seen = 1; blank = "\n" }' >"$text_file"
	else
		tr -d '\r' <"$stdin_file" >"$text_file"
	fi
	# Trim trailing whitespace-only content.
	if [ ! -s "$text_file" ]; then
		return 1
	fi

	head_line=$(head -c 8192 "$text_file" | head -1)
	if [ "$(file_size "$text_file")" -le 8192 ] && is_url "$head_line" &&
		[ "$(wc -l <"$text_file" | tr -d ' ')" -eq 0 ]; then
		kind=url
		domain=$(url_domain "$head_line")
		preview=$(url_preview "$head_line" "$domain")
	fi

	# The dedupe hash covers the plain text only. Two copies of the same words
	# are the same clip whether or not the second one carried markup, which is
	# the same key the Tauri app builds.
	hash=$(sha256_of "$kind" "$text_file")
	if consume_suppression "$hash"; then
		return 0
	fi
	app=$(source_app)
	html_file=$(read_html_flavor "$types")

	payload=$(mktempfile)
	{
		printf '{'
		json_field kind "$kind"
		printf ','
		json_field hash "$hash"
		printf ','
		json_field source_app "$app"
		printf ','
		json_field url_domain "$domain"
		printf ',"url_title":null,'
		# preview is left null for plain text on purpose: clipbasket-db derives
		# it in SQL, where substr() counts characters rather than bytes and so
		# cannot cut a multi-byte character in half.
		json_field preview "$preview"
		printf ','
		if [ -n "$html_file" ]; then
			printf '"html":"'
			json_escape_stream <"$html_file"
			printf '",'
		fi
		printf '"text":"'
		json_escape_stream <"$text_file"
		printf '"}'
	} >"$payload"
	record <"$payload"
}

main() {
	local mode="${1:-text}" types stdin_file

	[ -x "$DB_CLI" ] || {
		log "clipbasket-db not found at $DB_CLI"
		exit 1
	}
	clipboard_state_is_recordable || exit 0

	types=$(wl-paste --list-types 2>/dev/null || printf '')
	if offer_is_confidential "$types"; then
		log 'skipping confidential clipboard offer'
		exit 0
	fi

	# One offer, one clip. Priority mirrors the Tauri capture path: a file copy
	# beats the image beats the text rendering of the same thing.
	local has_files=0 has_image=0
	case "$types" in *text/uri-list*) has_files=1 ;; esac
	case "$types" in image/* | *$'\n'image/*) has_image=1 ;; esac

	stdin_file=$(mktempfile)
	cat >"$stdin_file"

	if [ "$has_files" = 1 ]; then
		# text/uri-list is also how some apps advertise a plain list of links,
		# so this only wins if the payload really resolves to local paths.
		if [ "$mode" = "text" ] && capture_files; then
			exit 0
		fi
		if [ "$mode" = "image" ] && wl-paste --no-newline --type text/uri-list 2>/dev/null |
			uri_list_paths | grep -q .; then
			exit 0
		fi
	fi

	case "$mode" in
	image)
		capture_image "$stdin_file" "$types" || true
		;;
	text)
		if [ "$has_image" = 1 ]; then
			# The image watcher owns this change; recording the text as well
			# would give one copy two rows.
			exit 0
		fi
		capture_text "$stdin_file" "$types" || true
		;;
	*)
		log "unknown mode: $mode"
		exit 2
		;;
	esac
}

main "$@"
