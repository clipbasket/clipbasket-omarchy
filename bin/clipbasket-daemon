#!/usr/bin/env bash
#
# clipbasket-daemon — keeps the clipboard watchers alive.
#
#   clipbasket-daemon start|stop|restart|status|foreground
#
# Two `wl-paste --watch` processes do the actual work, one per MIME family.
# They are separate processes because wl-paste can only watch one type at a
# time; clipbasket-capture decides between them so a copy that offers both an
# image and its alt text is still recorded once.
#
# This supervisor exists because wl-paste dies whenever the Wayland compositor
# restarts, and a clipboard manager that silently stops recording is worse than
# one that was never installed. Watchers are respawned with backoff, and a
# watcher that cannot stay up is reported rather than retried forever.

set -euo pipefail

STATE_DIR="${CLIPBASKET_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/clipbasket}"
PID_FILE="$STATE_DIR/daemon.pid"
LOG_FILE="$STATE_DIR/daemon.log"

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
CAPTURE="${CLIPBASKET_CAPTURE:-$SCRIPT_DIR/clipbasket-capture}"

# A watcher that exits faster than this is failing, not cycling normally.
readonly MIN_HEALTHY_SECONDS=5
readonly MAX_BACKOFF=60

log() {
	printf '%s clipbasket-daemon: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG_FILE"
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Whether the recorded pid is ours and still alive. A stale pid file left by a
# crash or a reboot must never stop a fresh start, and the pid must never be
# assumed to still belong to us — pids are recycled.
daemon_pid() {
	local pid
	[ -f "$PID_FILE" ] || return 1
	read -r pid <"$PID_FILE" 2>/dev/null || return 1
	[ -n "${pid:-}" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	# Confirm identity before we ever signal it.
	case "$(ps -o command= -p "$pid" 2>/dev/null)" in
	*clipbasket-daemon*) printf '%s' "$pid" ;;
	*) return 1 ;;
	esac
}

preflight() {
	command -v wl-paste >/dev/null 2>&1 ||
		die "wl-paste not found — sudo pacman -S wl-clipboard"
	[ -x "$CAPTURE" ] ||
		die "$CAPTURE is not executable"
	[ -n "${WAYLAND_DISPLAY:-}" ] ||
		die "WAYLAND_DISPLAY is unset — the daemon must run inside your Wayland session"
}

# Supervise one `wl-paste --watch`. Runs in the background for the life of the
# daemon; the caller keeps its pid so stop can take the whole tree down.
supervise() {
	local kind="$1" backoff=1 started elapsed
	while :; do
		started=$SECONDS
		wl-paste --type "$kind" --watch "$CAPTURE" "$kind" >>"$LOG_FILE" 2>&1 || true
		elapsed=$((SECONDS - started))
		if [ "$elapsed" -ge "$MIN_HEALTHY_SECONDS" ]; then
			# It ran normally and then the compositor went away. Come straight
			# back; this is the ordinary case on a Hyprland restart.
			backoff=1
			log "$kind watcher exited after ${elapsed}s; restarting"
		else
			log "$kind watcher died after ${elapsed}s; retrying in ${backoff}s"
			sleep "$backoff"
			backoff=$((backoff * 2))
			[ "$backoff" -gt "$MAX_BACKOFF" ] && backoff=$MAX_BACKOFF
		fi
	done
}

run_foreground() {
	preflight
	mkdir -p -- "$STATE_DIR"
	log "starting (pid $$, display ${WAYLAND_DISPLAY:-none})"
	printf '%s\n' "$$" >"$PID_FILE"

	local children=()
	# Take the watchers down with us however we are asked to leave, so a stop
	# never orphans a wl-paste that would keep writing to the database.
	cleanup() {
		local child
		for child in "${children[@]:-}"; do
			[ -n "${child:-}" ] && kill -- "-$child" 2>/dev/null || kill "$child" 2>/dev/null || true
		done
		rm -f -- "$PID_FILE"
		log "stopped"
	}
	trap cleanup EXIT INT TERM

	supervise text  & children+=("$!")
	supervise image & children+=("$!")

	wait
}

cmd_start() {
	local pid
	if pid="$(daemon_pid)"; then
		printf 'Already running (pid %s).\n' "$pid"
		return 0
	fi
	preflight
	mkdir -p -- "$STATE_DIR"
	rm -f -- "$PID_FILE"
	setsid "$0" foreground >/dev/null 2>&1 &
	# Wait for the child to claim the pid file rather than reporting success
	# and letting the user discover the failure in the log.
	local waited=0
	while [ "$waited" -lt 50 ]; do
		if pid="$(daemon_pid)"; then
			printf 'Started (pid %s).\n' "$pid"
			return 0
		fi
		sleep 0.1
		waited=$((waited + 1))
	done
	die "daemon did not come up — see $LOG_FILE"
}

cmd_stop() {
	local pid waited=0
	if ! pid="$(daemon_pid)"; then
		printf 'Not running.\n'
		rm -f -- "$PID_FILE"
		return 0
	fi
	kill "$pid" 2>/dev/null || true
	while [ "$waited" -lt 50 ]; do
		daemon_pid >/dev/null || { printf 'Stopped.\n'; return 0; }
		sleep 0.1
		waited=$((waited + 1))
	done
	kill -9 "$pid" 2>/dev/null || true
	rm -f -- "$PID_FILE"
	printf 'Stopped (forced).\n'
}

cmd_status() {
	local pid watchers
	if pid="$(daemon_pid)"; then
		watchers="$(pgrep -c -f "wl-paste --type .* --watch" 2>/dev/null || printf 0)"
		printf 'running   pid %s, %s watcher(s)\n' "$pid" "$watchers"
		[ "$watchers" -ge 2 ] || printf 'warning   expected 2 watchers; see %s\n' "$LOG_FILE"
		return 0
	fi
	printf 'stopped\n'
	return 1
}

case "${1:-status}" in
start)      cmd_start ;;
stop)       cmd_stop ;;
restart)    cmd_stop; cmd_start ;;
status)     cmd_status ;;
foreground) run_foreground ;;
-h|--help|help)
	sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
	;;
*) die "unknown command: $1 (try: start stop restart status foreground)" ;;
esac
