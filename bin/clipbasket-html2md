BASE_CASES = [
    (
        "relative link resolved against --base-url",
        "https://example.com/docs/page.html",
        '<p><a href="../img/a.png">x</a> <img src="/logo.png" alt="L"></p>',
        "[x](https://example.com/img/a.png) ![L](https://example.com/logo.png)",
    ),
    (
        "absolute urls are left alone",
        "https://example.com/",
        '<p><a href="https://other.test/x">x</a></p>',
        "[x](https://other.test/x)",
    ),
    (
        "fragment links resolve to the page",
        "https://example.com/a",
        '<p><a href="#top">x</a></p>',
        "[x](https://example.com/a#top)",
    ),
]


def selftest():
    passed = failed = 0
    sys.stdout.write("clipbasket-html2md selftest (built-in converter)\n")
    sys.stdout.write("  python:  %s\n" % sys.version.split()[0])
    sys.stdout.write(
        "  pandoc:  %s\n\n" % (shutil.which("pandoc") or "not installed (built-in only)")
    )

    def check(label, expected, actual):
        nonlocal passed, failed
        if expected == actual:
            passed += 1
            sys.stdout.write("PASS  %s\n" % label)
        else:
            failed += 1
            sys.stdout.write(
                "FAIL  %s\n        expected: %r\n        actual:   %r\n"
                % (label, expected, actual)
            )

    for label, source, expected in CASES:
        check(label, expected, convert(source).rstrip("\n"))
    for label, base, source, expected in BASE_CASES:
        check(label, expected, convert(source, base).rstrip("\n"))

    # A page-shaped document: every construct at once, with the noise a real
    # page carries between the tags.
    page = """
    <html><head><title>Doc</title><style>body{}</style></head>
    <body>
      <script>window.x = 1;</script>
      <div class="wrap">
        <h1>Report</h1>
        <p>Intro with a <a href="/a">link</a>, <strong>bold</strong> and
           <code>code()</code>.</p>
        <ul>
          <li>first</li>
          <li>second
            <ol><li>nested</li></ol>
          </li>
        </ul>
        <table>
          <thead><tr><th>K</th><th>V</th></tr></thead>
          <tbody><tr><td>a</td><td>1</td></tr></tbody>
        </table>
        <blockquote><p>quote</p></blockquote>
        <pre><code>x = 1</code></pre>
        <hr>
      </div>
    </body></html>
    """
    expected_page = (
        "# Report\n\n"
        "Intro with a [link](/a), **bold** and `code()`.\n\n"
        "- first\n- second\n  1. nested\n\n"
        "| K | V |\n| --- | --- |\n| a | 1 |\n\n"
        "> quote\n\n"
        "```\nx = 1\n```\n\n"
        "---"
    )
    check("a whole page round-trips", expected_page, convert(page).rstrip("\n"))

    # Nothing may ever crash on adversarial input.
    for label, source in (
        ("deeply nested divs", "<div>" * 200 + "x" + "</div>" * 200),
        ("unterminated tag", "<p>text<"),
        ("bare angle brackets", "a < b > c"),
        ("null-ish control chars", "<p>a\x01b\x02c\x00d</p>"),
        ("a table with no cells", "<table><tr></tr></table>"),
        ("attribute with no value", "<p hidden>x</p>"),
    ):
        try:
            convert(source)
            passed += 1
            sys.stdout.write("PASS  survives: %s\n" % label)
        except Exception as error:  # pragma: no cover - the point of the test
            failed += 1
            sys.stdout.write("FAIL  survives: %s -> %r\n" % (label, error))

    # The built-in path is bounded the way the pandoc path is bounded by its
    # 20 s timeout: past the input cap it says so instead of grinding.
    def raises_too_large(source, limit):
        try:
            convert(source, None, max_input=limit)
        except InputTooLarge:
            return "InputTooLarge"
        return "no error"

    check(
        "oversized input is a clear error, not unbounded work",
        "InputTooLarge",
        raises_too_large("<p>hello</p>", 4),
    )
    check(
        "input at the limit still converts",
        "hello",
        convert("<p>hello</p>", None, max_input=len("<p>hello</p>")).rstrip("\n"),
    )
    check(
        "the built-in converter caps input at 2 MiB by default",
        "InputTooLarge",
        raises_too_large("<p>" + "a" * BUILTIN_MAX_INPUT, None),
    )

    if shutil.which("pandoc"):
        out = pandoc_convert("<h1>Title</h1><p><a href='/a'>x</a></p>")
        check(
            "pandoc path produces a heading",
            True,
            out is not None and out.startswith("# Title"),
        )

    sys.stdout.write("\n%d passed, %d failed\n" % (passed, failed))
    return 0 if failed == 0 else 1


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:  # pragma: no cover
        sys.exit(0)
    except KeyboardInterrupt:  # pragma: no cover
        sys.exit(130)
