#!/usr/bin/env python3
"""clipbasket-html2md — turn the clipboard's text/html flavour into GFM Markdown.

Reads HTML on stdin, writes GitHub-Flavored Markdown on stdout.

    wl-paste --type text/html | clipbasket-html2md --base-url https://example.com/

This is the Linux stand-in for the turndown + turndown-plugin-gfm pipeline the
macOS/Windows app runs in the webview (see src/markdown/htmlToMarkdown.ts in the
Tauri repo). The rules are deliberately the same ones: ATX headings, `-` bullets,
fenced code, `*` emphasis, GFM tables, strikethrough and task list items.

Constraints that shape the implementation:

  * Python 3 standard library only. The product promise is "git clone and run",
    so adding a Python package or a new system package is not an option -- but Omarchy
    ships python3, and html.parser is in it.
  * pandoc is strictly better at this than anything that fits in one file, so it
    is used when it happens to be installed. It is never required, and the
    built-in converter is what the tests pin down.
  * Real pages are mostly whitespace. Anything that renders as nothing (script,
    style, head, empty wrappers) has to disappear rather than leave blank lines
    behind, or the paste is unreadable.

Exit status is 0 whenever some Markdown could be produced (including the empty
string for empty input); 2 for a usage error.
"""

import html
import os
import re
import shutil
import subprocess
import sys
from html.parser import HTMLParser
from urllib.parse import urljoin

# --- the shape of HTML -----------------------------------------------------

VOID_TAGS = frozenset(
    """area base br col embed hr img input link meta param source track wbr""".split()
)

# Content that renders as nothing at all. Dropped subtree and all, so a page's
# inline <script> never reaches the output as a wall of JavaScript.
SKIPPED_TAGS = frozenset(
    """script style head title meta link base noscript template svg math
       object applet iframe frameset""".split()
)

# Everything that starts a new line in the output. Anything not listed here is
# treated as inline, which is the right default for the long tail of custom
# elements a real page carries.
BLOCK_TAGS = frozenset(
    """address article aside blockquote body caption center dd details dialog
       div dl dt fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header
       hgroup hr html li main menu nav ol p pre section summary table tbody td
       tfoot th thead tr ul""".split()
)

HEADING_TAGS = {"h1": 1, "h2": 2, "h3": 3, "h4": 4, "h5": 5, "h6": 6}

# Emphasis that maps onto a Markdown delimiter pair.
EMPHASIS = {
    "strong": "**",
    "b": "**",
    "em": "*",
    "i": "*",
    "cite": "*",
    "dfn": "*",
    "var": "*",
    "s": "~~",
    "del": "~~",
    "strike": "~~",
}

# Inline elements whose own markup is dropped but whose text is kept.
TRANSPARENT_INLINE = frozenset(
    """span font a-ignored small big u ins mark abbr acronym time data output
       bdi bdo ruby rt rp label legend sup sub nobr wbr-text""".split()
)

# Rendered as nothing, but their presence still matters (br, checkbox inputs).
NO_OUTPUT_INLINE = frozenset("""input select textarea option optgroup""".split())

# Marks a hard line break through normalisation, which strips trailing spaces
# and would otherwise eat the two spaces that make one.
HARD_BREAK = "\x00"
# Wraps a run of text that must survive normalisation byte for byte: code spans,
# fenced code bodies, and every URL.
LIT_OPEN, LIT_CLOSE = "\x01", "\x02"
LIT_RE = re.compile(LIT_OPEN + r"(\d+)" + LIT_CLOSE)
# The three bytes above are an internal alphabet, so they must not be able to
# arrive from outside: a page carrying \x01 7 \x02 would otherwise index into
# the literal table (IndexError, or somebody else's code span spliced in), and
# a \x00 in a text node would render as a hard line break. Stripped at the
# door, once, for every entry point.
SENTINEL_RE = re.compile("[\x00\x01\x02]")

# The built-in converter is pure Python over a whole document tree, so a
# pathological page can take unbounded time. pandoc gets a 20 s timeout; this
# is the equivalent bound for the fallback path -- a clear error rather than a
# UI that never comes back.
BUILTIN_MAX_INPUT = 2 * 1024 * 1024

# html.parser hands back a tree as deep as the source nests, and rendering
# walks it recursively. Real pages do not nest 800 deep; fuzzers and broken
# minifiers do, and RecursionError is not an acceptable answer to a paste.
MAX_TREE_DEPTH = 500
sys.setrecursionlimit(10000)


class InputTooLarge(ValueError):
    """Raised by convert() when the built-in path would be unbounded work."""


class Element(object):
    __slots__ = ("tag", "attrs", "children")

    def __init__(self, tag, attrs=None):
        self.tag = tag
        self.attrs = attrs or {}
        self.children = []

    def get(self, name, default=None):
        return self.attrs.get(name, default)

    def __repr__(self):  # pragma: no cover - debugging aid
        return "<%s %d children>" % (self.tag, len(self.children))


class TreeBuilder(HTMLParser):
    """html.parser, plus the implicit end tags a browser would have inserted.

    html.parser is a tokenizer, not a tree builder: it will happily hand back
    `<li>a<li>b` as two nested list items. The auto-closing rules below are the
    subset of the HTML5 "in body" insertion modes that matters for clipboard
    HTML -- lists, definition lists, tables and paragraphs.
    """

    def __init__(self):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.root = Element("#root")
        self.stack = [self.root]
        self.skipping = []

    # -- tree helpers --
    def _current(self):
        return self.stack[-1]

    def _append(self, node):
        self._current().children.append(node)

    def _pop_to(self, index):
        while len(self.stack) > index:
            self.stack.pop()

    def _close_until(self, targets, boundaries):
        """Close the nearest open `targets` element, unless a `boundaries`
        element is open more recently -- that is what keeps a nested <ul>'s
        first <li> from closing the <li> that contains the list."""
        for index in range(len(self.stack) - 1, 0, -1):
            tag = self.stack[index].tag
            if tag in targets:
                self._pop_to(index)
                return
            if tag in boundaries:
                return

    def _implicit_close(self, tag):
        if tag == "li":
            self._close_until({"li"}, {"ul", "ol", "menu"})
        elif tag in ("dt", "dd"):
            self._close_until({"dt", "dd"}, {"dl"})
        elif tag in ("td", "th"):
            self._close_until({"td", "th"}, {"tr", "table"})
        elif tag == "tr":
            self._close_until({"tr", "td", "th"}, {"table", "thead", "tbody", "tfoot"})
        elif tag in ("thead", "tbody", "tfoot"):
            self._close_until(
                {"tr", "td", "th", "thead", "tbody", "tfoot"}, {"table"}
            )
        elif tag in BLOCK_TAGS and self._current().tag == "p":
            self.stack.pop()

    # -- parser callbacks --
    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if self.skipping:
            if tag == self.skipping[-1]:
                self.skipping.append(tag)
            return
        if tag in SKIPPED_TAGS:
            if tag not in VOID_TAGS:
                self.skipping.append(tag)
            return

        self._implicit_close(tag)
        if len(self.stack) >= MAX_TREE_DEPTH:
            # Past the cap the element is flattened away: its text keeps
            # arriving, it just lands in the deepest ancestor we did keep. A
            # stray close tag for it finds nothing on the stack and is ignored,
            # exactly as a browser ignores one.
            return
        node = Element(tag, {k.lower(): (v if v is not None else "") for k, v in attrs})
        self._append(node)
        if tag not in VOID_TAGS:
            self.stack.append(node)

    def handle_startendtag(self, tag, attrs):
        tag = tag.lower()
        if self.skipping:
            return
        if tag in SKIPPED_TAGS:
            return
        self._implicit_close(tag)
        self._append(
            Element(tag, {k.lower(): (v if v is not None else "") for k, v in attrs})
        )

    def handle_endtag(self, tag):
        tag = tag.lower()
        if self.skipping:
            if tag == self.skipping[-1]:
                self.skipping.pop()
            return
        if tag in VOID_TAGS:
            return
        for index in range(len(self.stack) - 1, 0, -1):
            if self.stack[index].tag == tag:
                self._pop_to(index)
                return
        # Stray close tag: browsers ignore it, and so do we.

    def handle_data(self, data):
        if self.skipping or not data:
            return
        self._append(data)

    def handle_entityref(self, name):  # convert_charrefs handles the common path
        if not self.skipping:
            self._append(html.unescape("&%s;" % name))

    def handle_charref(self, name):
        if not self.skipping:
            self._append(html.unescape("&#%s;" % name))


def parse(source):
    builder = TreeBuilder()
    builder.feed(source)
    builder.close()
    return builder.root


# --- rendering -------------------------------------------------------------

WS_RE = re.compile(r"[\s ]+")
# Turndown's escape list, minus the ones that only make sense at a line start
# (those are applied per block instead).
INLINE_ESCAPES = ("\\", "`", "*", "_", "[", "]")
LINE_START_RE = re.compile(r"^(\s*)(#{1,6} |>|\+ |- |\* |=+$)")
LINE_START_NUMBER_RE = re.compile(r"^(\s*\d+)(\. )")


def is_ws(node):
    return isinstance(node, str) and not node.strip()


def first_element(node):
    for child in node.children:
        if isinstance(child, Element):
            return child
        if child.strip():
            return None
    return None


class Block(object):
    """A rendered block plus the tag that produced it, so a list can be joined
    tightly to the paragraph above it inside a list item."""

    __slots__ = ("text", "tag")

    def __init__(self, text, tag):
        self.text = text
        self.tag = tag


class Renderer(object):
    def __init__(self, base_url=None):
        self.base_url = base_url or None
        self.literals = []

    # -- literal protection --
    def lit(self, text):
        self.literals.append(text)
        return "%s%d%s" % (LIT_OPEN, len(self.literals) - 1, LIT_CLOSE)

    def restore(self, text):
        return LIT_RE.sub(lambda m: self.literals[int(m.group(1))], text)

    # -- urls --
    def url(self, value):
        value = (value or "").strip()
        if not value:
            return ""
        value = WS_RE.sub("", value)
        if value.lower().startswith("javascript:"):
            return ""
        if self.base_url:
            try:
                value = urljoin(self.base_url, value)
            except ValueError:
                pass
        return value

    def link_target(self, url, title):
        target = self.lit(url.replace("(", "%28").replace(")", "%29"))
        if title:
            return '%s "%s"' % (target, WS_RE.sub(" ", title).replace('"', "'").strip())
        return target

    # -- inline --
    def inline(self, nodes):
        return "".join(self.inline_one(node) for node in nodes)

    def inline_one(self, node):
        if isinstance(node, str):
            return escape_inline(WS_RE.sub(" ", node))

        tag = node.tag
        if tag == "br":
            return HARD_BREAK
        if tag in NO_OUTPUT_INLINE:
            return ""
        if tag == "img":
            return self.image(node)
        if tag == "a":
            return self.anchor(node)
        if tag == "code" or tag == "kbd" or tag == "samp" or tag == "tt":
            return self.code_span(node)
        if tag == "q":
            return "“" + self.inline(node.children) + "”"
        if tag in EMPHASIS:
            return self.emphasis(node, EMPHASIS[tag])
        if tag == "wbr":
            return ""
        return self.inline(node.children)

    def emphasis(self, node, delimiter):
        inner = self.inline(node.children)
        stripped = inner.strip()
        if not stripped:
            return " " if inner else ""
        lead = " " if inner[:1].isspace() else ""
        trail = " " if inner[-1:].isspace() else ""
        return "%s%s%s%s%s" % (lead, delimiter, stripped, delimiter, trail)

    def code_span(self, node):
        text = WS_RE.sub(" ", raw_text(node)).strip()
        if not text:
            return ""
        longest = max((len(run) for run in re.findall(r"`+", text)), default=0)
        fence = "`" * (longest + 1)
        pad = " " if text.startswith("`") or text.endswith("`") else ""
        return self.lit("%s%s%s%s%s" % (fence, pad, text, pad, fence))

    def image(self, node):
        src = self.url(node.get("src") or node.get("data-src") or "")
        if not src:
            return ""
        alt = WS_RE.sub(" ", node.get("alt", "")).strip()
        alt = alt.replace("[", "\\[").replace("]", "\\]")
        return "![%s](%s)" % (alt, self.link_target(src, node.get("title")))

    def anchor(self, node):
        label = self.inline(node.children).strip()
        href = self.url(node.get("href") or "")
        if not href:
            return label
        if not label:
            return ""
        return "[%s](%s)" % (label, self.link_target(href, node.get("title")))

    # -- blocks --
    def blocks(self, node):
        out = []
        run = []
        for child in node.children:
            if isinstance(child, str):
                run.append(child)
            elif child.tag in BLOCK_TAGS:
                self.flush(run, out)
                out.extend(self.block(child))
            else:
                run.append(child)
        self.flush(run, out)
        return out

    def flush(self, run, out):
        if not run:
            return
        text = tidy_inline(self.inline(run))
        run[:] = []
        if text:
            out.append(Block(escape_line_start(text), "p"))

    def block(self, node):
        tag = node.tag

        if tag in HEADING_TAGS:
            text = tidy_inline(self.inline(node.children)).replace(HARD_BREAK, " ")
            text = WS_RE.sub(" ", text).strip()
            return [Block("#" * HEADING_TAGS[tag] + " " + text, tag)] if text else []

        if tag == "hr":
            return [Block("---", tag)]

        if tag == "pre":
            return self.pre(node)

        if tag in ("ul", "ol", "menu"):
            return self.list(node)

        if tag == "blockquote":
            inner = join_blocks(self.blocks(node))
            if not inner:
                return []
            quoted = "\n".join(
                ("> " + line).rstrip() if line else ">" for line in inner.split("\n")
            )
            return [Block(quoted, tag)]

        if tag == "table":
            return self.table(node)

        if tag in ("td", "th", "tr", "thead", "tbody", "tfoot", "caption"):
            # Only reachable for stray table parts outside a <table>.
            return self.blocks(node)

        if tag == "dl":
            out = []
            for child in node.children:
                if isinstance(child, Element) and child.tag in ("dt", "dd"):
                    inner = join_blocks(self.blocks(child))
                    if not inner:
                        continue
                    if child.tag == "dd":
                        inner = "\n".join(
                            ("    " + line).rstrip() for line in inner.split("\n")
                        )
                    out.append(Block(inner, child.tag))
            return out

        if tag == "li":
            # A stray <li> outside a list still deserves a bullet.
            wrapper = Element("ul")
            wrapper.children.append(node)
            return self.list(wrapper)

        # div, section, figure, details, body, ... are pure containers.
        return self.blocks(node)

    def pre(self, node):
        body = raw_text(node)
        body = body.replace("\r\n", "\n").replace("\r", "\n")
        body = body.strip("\n")
        if not body.strip():
            return []
        language = code_language(node)
        # Every backtick run in the body counts, not just the ones at column 0:
        # an indented ``` inside the code would otherwise close the fence early
        # and spill the rest of the block into the document as prose.
        longest = max((len(run) for run in re.findall(r"`+", body)), default=0)
        fence = "`" * max(3, longest + 1)
        return [
            Block(self.lit("%s%s\n%s\n%s" % (fence, language, body, fence)), "pre")
        ]

    def list(self, node):
        ordered = node.tag == "ol"
        try:
            number = int(node.get("start", "1"))
        except ValueError:
            number = 1

        lines = []
        for child in node.children:
            if not isinstance(child, Element) or child.tag != "li":
                continue
            marker = ("%d. " % number) if ordered else "- "
            item = self.list_item(child)
            if item is None:
                continue
            if ordered:
                try:
                    number = int(child.get("value", number))
                except ValueError:
                    pass
                number += 1
            indent = " " * len(marker)
            item_lines = item.split("\n")
            lines.append((marker + item_lines[0]).rstrip())
            for line in item_lines[1:]:
                lines.append((indent + line).rstrip() if line else "")
        if not lines:
            return []
        return [Block("\n".join(lines), node.tag)]

    def list_item(self, node):
        checkbox = find_checkbox(node)
        blocks = self.blocks(node)
        text = join_blocks(blocks, tight_lists=True)
        if checkbox is None and not text:
            return None
        if checkbox is not None:
            mark = "[x] " if checkbox else "[ ] "
            text = mark + text if text else mark.rstrip()
        return text

    def table(self, node):
        rows, header = collect_rows(self, node)
        if not rows and not header:
            return []
        width = max(len(row) for row in ([header] if header else []) + rows)
        if not width:
            return []

        alignments = ["" for _ in range(width)]
        if header:
            for index, cell in enumerate(header):
                alignments[index] = cell[1]
            head_cells = [cell[0] for cell in header]
        else:
            # GFM has no headerless table; turndown-plugin-gfm emits an empty
            # header row for one, and so do we.
            head_cells = ["" for _ in range(width)]

        out = [render_row(head_cells, width), render_divider(alignments, width)]
        for row in rows:
            out.append(render_row([cell[0] for cell in row], width))

        blocks = []
        caption = find_child(node, "caption")
        if caption is not None:
            text = tidy_inline(self.inline(caption.children))
            if text:
                blocks.append(Block(escape_line_start(text), "p"))
        blocks.append(Block("\n".join(out), "table"))
        return blocks

    def cell_text(self, node):
        text = tidy_inline(self.inline_or_blocks(node))
        text = text.replace(HARD_BREAK, " ").replace("\n", " ")
        text = re.sub(r"(?<!\\)\|", r"\\|", text)
        return WS_RE.sub(" ", text).strip()

    def inline_or_blocks(self, node):
        """Cells usually hold inline content; when they hold blocks, flatten
        them to one line rather than dropping them."""
        if any(
            isinstance(child, Element) and child.tag in BLOCK_TAGS
            for child in node.children
        ):
            return join_blocks(self.blocks(node)).replace("\n\n", " ").replace("\n", " ")
        return self.inline(node.children)

    # -- entry point --
    def convert(self, source):
        source = SENTINEL_RE.sub("", source)
        root = parse(source)
        if self.base_url is None:
            self.base_url = document_base(root)
        text = join_blocks(self.blocks(root))
        return self.normalise(text)

    def normalise(self, text):
        # Runs of spaces are collapsed only *after* a non-space, so list and
        # blockquote indentation survives while a page's inter-tag padding does
        # not.
        text = re.sub(r"(?<=\S)[ \t]{2,}", " ", text)
        text = re.sub(r"[ \t]+\n", "\n", text)
        text = re.sub(r"\n{3,}", "\n\n", text)
        text = text.strip("\n")
        text = text.replace(HARD_BREAK, "  \n")
        text = self.restore(text)
        return text + "\n" if text else ""


# --- small helpers ---------------------------------------------------------


def escape_inline(text):
    for char in INLINE_ESCAPES:
        text = text.replace(char, "\\" + char)
    return text


def escape_line_start(text):
    out = []
    for line in text.split("\n"):
        match = LINE_START_RE.match(line)
        if match:
            line = line[: match.end(1)] + "\\" + line[match.end(1) :]
        else:
            # "1. " has to keep its digits and take the backslash before the
            # dot, or the escape reads as part of the number.
            line = LINE_START_NUMBER_RE.sub(r"\1\\\2", line, count=1)
        out.append(line)
    return "\n".join(out)


def tidy_inline(text):
    text = re.sub(r"[ \t]*%s[ \t]*" % HARD_BREAK, HARD_BREAK, text)
    return text.strip(" \t\n")


def join_blocks(blocks, tight_lists=False):
    out = ""
    for index, block in enumerate(blocks):
        if not block.text:
            continue
        if not out:
            out = block.text
            continue
        tight = tight_lists and block.tag in ("ul", "ol", "menu")
        out += ("\n" if tight else "\n\n") + block.text
    return out


def raw_text(node):
    if isinstance(node, str):
        return node
    if node.tag == "br":
        return "\n"
    if node.tag in NO_OUTPUT_INLINE:
        return ""
    return "".join(raw_text(child) for child in node.children)


def find_child(node, tag):
    for child in node.children:
        if isinstance(child, Element) and child.tag == tag:
            return child
    return None


def document_base(root):
    """<base href> only reaches us when the source kept it outside <head>;
    harmless when it does not."""
    stack = [root]
    while stack:
        node = stack.pop()
        for child in node.children:
            if isinstance(child, Element):
                if child.tag == "base" and child.get("href"):
                    return child.get("href")
                stack.append(child)
    return None


def code_language(node):
    for candidate in (find_child(node, "code"), node):
        if candidate is None:
            continue
        classes = (candidate.get("class") or "").split()
        for name in classes:
            for prefix in ("language-", "lang-", "highlight-source-", "brush:"):
                if name.startswith(prefix) and len(name) > len(prefix):
                    return name[len(prefix) :]
    return ""


def find_checkbox(node):
    """True/False when the list item starts with a checkbox, else None."""
    stack = list(node.children)
    while stack:
        child = stack.pop(0)
        if isinstance(child, str):
            if child.strip():
                return None
            continue
        if child.tag == "input":
            if (child.get("type", "") or "").lower() == "checkbox":
                return "checked" in child.attrs
            return None
        if child.tag in ("p", "label", "span", "div"):
            stack = list(child.children) + stack
            continue
        return None
    return None


def cell_alignment(node):
    align = (node.get("align") or "").strip().lower()
    if not align:
        style = (node.get("style") or "").lower()
        match = re.search(r"text-align\s*:\s*(left|center|right)", style)
        align = match.group(1) if match else ""
    return align if align in ("left", "center", "right") else ""


def collect_rows(renderer, table):
    """Returns (body_rows, header_row). Cells are (text, alignment) pairs, so
    the structure walk and the content render happen in one pass."""
    sections = {"thead": [], "tbody": [], "tfoot": []}
    loose = []

    def walk(node, bucket):
        for child in node.children:
            if not isinstance(child, Element):
                continue
            if child.tag in ("thead", "tbody", "tfoot"):
                walk(child, sections[child.tag])
            elif child.tag == "tr":
                bucket.append(child)

    walk(table, loose)
    ordered = sections["thead"] + sections["tbody"] + loose + sections["tfoot"]
    if not ordered:
        # `<table><td>a</td><td>b</td></table>` is malformed but common in
        # hand-written and template-generated mail. Without a <tr> to hang the
        # cells on the whole table used to vanish; synthesise the row a browser
        # would have inserted instead.
        synthetic = synthesise_row(table)
        if synthetic is None:
            return [], None
        ordered = [synthetic]

    def cells(row):
        out = []
        for child in row.children:
            if not isinstance(child, Element) or child.tag not in ("td", "th"):
                continue
            text = renderer.cell_text(child)
            align = cell_alignment(child)
            out.append((text, align))
            try:
                span = int(child.get("colspan", "1"))
            except ValueError:
                span = 1
            for _ in range(max(0, min(span, 32) - 1)):
                out.append(("", align))
        return out

    header = None
    body = ordered
    if sections["thead"]:
        header = cells(sections["thead"][0])
        body = [row for row in ordered if row is not sections["thead"][0]]
    else:
        first = ordered[0]
        if first.children and all(
            child.tag == "th"
            for child in first.children
            if isinstance(child, Element) and child.tag in ("td", "th")
        ) and any(
            isinstance(child, Element) and child.tag == "th" for child in first.children
        ):
            header = cells(first)
            body = ordered[1:]
    return [cells(row) for row in body], header


def synthesise_row(table):
    """A single <tr> holding every stray <td>/<th> the table owns directly, or
    None when there are none. Section wrappers are searched too, because
    `<table><tbody><td>x</td></tbody></table>` loses its row the same way."""
    row = Element("tr")
    for child in table.children:
        if not isinstance(child, Element):
            continue
        if child.tag in ("td", "th"):
            row.children.append(child)
        elif child.tag in ("thead", "tbody", "tfoot"):
            for cell in child.children:
                if isinstance(cell, Element) and cell.tag in ("td", "th"):
                    row.children.append(cell)
    return row if row.children else None


def render_row(cells, width):
    padded = list(cells) + ["" for _ in range(width - len(cells))]
    return "| " + " | ".join(padded[:width]) + " |"


def render_divider(alignments, width):
    parts = []
    for index in range(width):
        align = alignments[index] if index < len(alignments) else ""
        if align == "left":
            parts.append(":---")
        elif align == "center":
            parts.append(":---:")
        elif align == "right":
            parts.append("---:")
        else:
            parts.append("---")
    return "| " + " | ".join(parts) + " |"


# --- top level -------------------------------------------------------------


def convert(source, base_url=None, max_input=None):
    limit = BUILTIN_MAX_INPUT if max_input is None else max_input
    if limit and source and len(source) > limit:
        raise InputTooLarge(
            "input is %d characters; the built-in converter's limit is %d"
            % (len(source), limit)
        )
    source = SENTINEL_RE.sub("", source or "")
    if not source or not source.strip():
        return ""
    return Renderer(base_url).convert(source)


def pandoc_convert(source, base_url=None):
    """pandoc is strictly better at this than one file of html.parser, so it
    wins when it is installed. Never required."""
    binary = shutil.which("pandoc")
    if not binary:
        return None
    command = [binary, "-f", "html", "-t", "gfm", "--wrap=none"]
    try:
        result = subprocess.run(
            command,
            input=source.encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    text = result.stdout.decode("utf-8", "replace")
    if base_url:
        text = absolutise_markdown_links(text, base_url)
    return re.sub(r"\n{3,}", "\n\n", text).strip("\n")


def absolutise_markdown_links(text, base_url):
    def fix(match):
        target = match.group(2).strip()
        if not target or target.startswith("#") or re.match(r"^[a-zA-Z][\w+.-]*:", target):
            return match.group(0)
        return "%s(%s%s)" % (match.group(1), urljoin(base_url, target), match.group(3))

    return re.sub(r"(!?\[[^\]]*\])\(([^()\s]*)((?:\s+\"[^\"]*\")?)\)", fix, text)


def decode(data):
    for bom, encoding in (
        (b"\xef\xbb\xbf", "utf-8-sig"),
        (b"\xff\xfe", "utf-16"),
        (b"\xfe\xff", "utf-16"),
    ):
        if data.startswith(bom):
            return data.decode(encoding, "replace")
    return data.decode("utf-8", "replace")


def usage(stream=sys.stderr, status=2):
    stream.write(
        "usage: clipbasket-html2md [--base-url URL] [--builtin] [--selftest]\n"
        "       HTML on stdin, GitHub-Flavored Markdown on stdout.\n"
    )
    return status


def main(argv):
    base_url = None
    builtin = os.environ.get("CLIPBASKET_HTML2MD_PANDOC") == "0"
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--base-url":
            if not args:
                return usage()
            base_url = args.pop(0)
        elif arg.startswith("--base-url="):
            base_url = arg.split("=", 1)[1]
        elif arg in ("--builtin", "--no-pandoc"):
            builtin = True
        elif arg == "--selftest":
            return selftest()
        elif arg in ("-h", "--help"):
            return usage(sys.stdout, 0)
        else:
            sys.stderr.write("clipbasket-html2md: unknown option %s\n" % arg)
            return usage()

    source = SENTINEL_RE.sub("", decode(sys.stdin.buffer.read()))
    markdown = None
    if not builtin and source.strip():
        markdown = pandoc_convert(source, base_url)
    if markdown is None:
        try:
            markdown = convert(source, base_url)
        except InputTooLarge as error:
            sys.stderr.write(
                "clipbasket-html2md: %s.\n"
                "Install pandoc to convert documents this large.\n" % error
            )
            return 3
    out = markdown.rstrip("\n")
    sys.stdout.write(out + "\n" if out else "")
    return 0


